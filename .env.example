# Copy to .env (never commit it). Only what you set is used — everything has a safe default.

PORT=8788
NODE_ENV=production

# ── Database ──────────────────────────────────────────────
# Leave DATABASE_URL empty to use a local SQLite file (fine for a VPS with a persistent disk).
# On hosts with ephemeral disks (Render/Railway/Vercel/Fly) use PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SQLITE_PATH=./data/hkdevlab.db

# ── Email (SMTP) ──────────────────────────────────────────
# Cloudflare Email Routing only FORWARDS incoming mail, so sending needs a sending service.
# Recommended: Resend (free tier) — verify hkdevlab.com there, create an API key, then:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=re_xxxxxxxx
# Notifications go to MAIL_TO (Cloudflare forwards contact@ to your real inbox); Reply-To is the visitor.
# With SMTP_HOST empty, emails are only printed to the console.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="HK DevLab <website@hkdevlab.com>"
MAIL_TO=contact@hkdevlab.com

# ── Admin portal at /admin ────────────────────────────────
# There is no admin password to configure: the FIRST person to finish setup at /admin becomes the admin,
# then setup closes for good. To make sure that person is you, set a private key and enter it during setup:
SETUP_TOKEN=
# (forgot your password? run:  npm run reset-password -- you@example.com "new long password")

# ── "Continue with Google" for the admin portal (optional) ──
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
# 2) Authorized redirect URIs:  http://localhost:5180/api/auth/google/callback   and   https://YOUR-DOMAIN/api/auth/google/callback
# 3) Paste the Client ID and secret here. Buttons appear automatically once both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address of the site (no trailing slash). Must match the redirect URI above. Empty in dev = http://localhost:5180
PUBLIC_URL=

# ── Misc ──────────────────────────────────────────────────
# Extra origins allowed to POST /api/contact (only needed if the site is served from a different domain)
# ALLOWED_ORIGINS=https://www.hkdevlab.com
IP_HASH_SALT=change-me-to-a-random-string

# ── SEO Agent (Admin → SEO) ───────────────────────────────
# Crawler safety limits. All optional — sensible defaults apply if left empty.
# SEO_MAX_PAGES=100
# SEO_MAX_DEPTH=5
# SEO_REQUEST_TIMEOUT_MS=10000
# SEO_CRAWL_DELAY_MS=250
# AI recommendations (Admin → SEO → Recommendations). Without this, the SEO dashboard still crawls and
# reports issues — it just can't draft a suggested fix; "Get AI recommendation" reports itself unavailable.
ANTHROPIC_API_KEY=
# Optional overrides — sensible defaults apply if left empty.
# ANTHROPIC_MODEL=claude-sonnet-5
# SEO_LLM_TIMEOUT_MS=20000
# Optional: real PageSpeed Insights performance scoring for the scanned homepage. Without it, the scan
# still runs — performance reporting is simply marked unavailable rather than showing a fake number.
PAGESPEED_API_KEY=
