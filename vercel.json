{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/api" },
    { "source": "/media/(.*)", "destination": "/api" }
  ],
  "headers": [
    { "source": "/assets/projects/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/admin/**,content/**}",
      "maxDuration": 30
    }
  }
}
